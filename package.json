{
  "name": "@cordura/alma",
  "version": "0.1.0",
  "description": "ALMA, el sistema de diseño de Cordura: tokens y componentes.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:Cordura-art/alma",
  "files": [
    "dist"
  ],
  "exports": {
    "./css": "./dist/css/alma.css",
    "./tokens": "./dist/js/tokens.mjs",
    "./tokens.json": "./dist/json/tokens.json"
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs && node scripts/build-pictogramas.mjs && node scripts/build-portada.mjs && node scripts/build-docs.mjs",
    "test": "node scripts/check-roundtrip.mjs && node scripts/check-contrast.mjs && node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "site": "node scripts/build-site.mjs",
    "tokens:apply": "node scripts/apply-changes.mjs",
    "tuner": "node scripts/build-tuner.mjs",
    "images": "node scripts/build-images.mjs",
    "carta": "node scripts/carta.mjs",
    "entidades": "node scripts/build-entidades.mjs",
    "buscar-fecha": "node scripts/buscar-fecha.mjs",
    "lenguaje": "node scripts/build-entidades.mjs && node scripts/build-lenguaje.mjs",
    "entidad": "node scripts/entidad.mjs",
    "entidad:nueva": "node scripts/nueva-entidad.mjs",
    "sistemas": "node scripts/build-selector.mjs",
    "laminas": "node scripts/laminas.mjs",
    "genes": "node scripts/genes.mjs",
    "figuras:unity": "node scripts/figuras-unity.mjs",
    "documentacion": "node scripts/build-site.mjs --entidad",
    "documentacion:imagenes": "node scripts/build-images.mjs --entidad",
    "ejemplo": "node ejemplos/ensayo-cafe/build.mjs",
    "palabra": "node ejemplos/palabra/build.mjs",
    "ejemplo:generativo": "node ejemplos/ensayo-generativo/build.mjs",
    "figura": "node scripts/build-figura.mjs",
    "figuras:revisar": "node scripts/revisar-figuras.mjs",
    "escaneo": "node scripts/build-escaneo.mjs",
    "mundo": "node scripts/build-mundo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "style-dictionary": "^5.5.5"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  }
}
